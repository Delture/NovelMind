# Copy this file to .env and adjust values when needed.

APP_NAME=NovelMind
DATABASE_URL=sqlite:///./data/novelmind.db
BACKEND_URL=http://127.0.0.1:8000

# DeepSeek V4 Pro generation (keep the real key only in your local .env).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=660
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_MAX_TOKENS=8192

# Alibaba Cloud Model Studio (Bailian), China (Beijing).
# Use the dedicated endpoint shown in the selected workspace. Do not use a
# trial endpoint or an endpoint from another region.
# Example:
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_ATTEMPTS=3

# Local vector storage contains derived vectors, not a local model.
VECTOR_STORE_PATH=./vector_store
