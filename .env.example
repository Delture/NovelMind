# Copy this file to .env and adjust values when needed.

APP_NAME=NovelMind
DATABASE_URL=sqlite:///./data/novelmind.db

# Generation. The frontend can override these values without restarting.
GENERATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=660
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_MAX_TOKENS=8192
# Chapter-summary request scheduling. Auto starts conservatively and adapts;
# manual uses the selected value directly. Known model ceilings still apply.
SUMMARY_CONCURRENCY_MODE=auto
SUMMARY_MAX_CONCURRENCY=2500

# Embedding. SiliconFlow uses its official OpenAI-compatible API root.
# The frontend can also select another OpenAI-compatible endpoint.
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_ATTEMPTS=3

# Local vector storage contains derived vectors, not a local model.
VECTOR_STORE_PATH=./vector_store
